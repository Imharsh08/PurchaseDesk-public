# PostgreSQL connection string (Neon, Supabase, RDS, or local "npm run db:dev")
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/purchasedesk?sslmode=require"
# Direct (non-pooled) URL used for Prisma migrations; on Neon, `neon link` fills this in
DATABASE_URL_UNPOOLED=""
# Optional: max pool connections. Set to 1 only for the local prisma dev database.
# DATABASE_POOL_MAX=1

# 32+ random bytes, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""

# PO PDFs and logos go to Neon Object Storage when the AWS_* variables from `neon link` are set;
# otherwise to this local folder.
STORAGE_DIR="./storage"
STORAGE_BUCKET="purchasedocs"
# Set to "local" to force local disk even when AWS_* are set (testing against a Neon branch)
# STORAGE_DRIVER="local"

# Sign-in. With GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET blank, users sign in with email + password:
# the first admin comes from "npm run db:seed", then admins add users (and reset passwords) in Users.
# With them set, "Sign in with Google" is the only way in; add APP_URL/api/auth/google/callback
# (and, for the web app, <API address>/auth/google/callback) as authorised redirect URIs.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Only accounts on this email domain can be added / sign in, e.g. "yourcompany.com" (blank = any)
ALLOWED_EMAIL_DOMAIN=""

# Email: each user sends from their own Google mailbox via the Gmail API ("Connect Gmail" in the
# profile menu). Needs Google sign-in above and the Gmail API enabled in that Google Cloud project.
# Without it, use "Mark as sent" and share the downloaded PDF.

# Public URL of the Next.js app (links in emails, Google redirect)
APP_URL="http://localhost:3000"

# Web app (Cloudflare Pages) address(es) the API accepts, comma-separated; preview deployments of a
# *.pages.dev address are accepted too. Set on the API (Neon Function).
WEB_APP_URL="https://purchasedesk.pages.dev"

# Who may permanently delete records (with the admin delete password set in Settings), comma-separated
DELETE_ADMIN_EMAILS=""

# Optional: AI invoice reading in the web app (Google Gemini API key), set on the API
# GEMINI_API_KEY=""

# First admin login created by "npm run db:seed" (random password printed if unset)
# SEED_ADMIN_EMAIL="admin@yourcompany.com"
# SEED_ADMIN_PASSWORD=""
